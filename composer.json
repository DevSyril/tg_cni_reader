{
    "name": "devsyril/tg-document-reader",
    "version": "1.1.0",
    "description": "Togolese identity documents OCR processor - extracts and validates data from CNI, passport, and driver license images.",
    "type": "library",
    "license": "MIT",
    "readme": "README.md",
    "keywords": [
        "Togo",
        "CNI",
        "Passport",
        "Driver License",
        "OCR",
        "Identification",
        "Identity Card",
        "Extraction",
        "Validation"
    ],
    "autoload": {
        "psr-4": {
            "TgDocumentProcessor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevSyril\\DocumentReader\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kokou Yaovi Syril",
            "role": "Creator",
            "email": "kokousyril@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "thiagoalessio/tesseract_ocr": "^2.13",
        "spatie/pdf-to-image": "^3.0",
        "intervention/image": "^3.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}