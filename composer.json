{
    "name": "devsyril/tg-cni-reader",
    "version": "1.1.1",
    "description": "Togolese National ID Card (CNI) OCR processor - extracts and validates data from CNI card images",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TgIdProcessor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevSyril\\CniReader\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kokou Yaovi Syril",
            "role": "Creator",
            "email": "kokousyril@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "thiagoalessio/tesseract_ocr": "^2.13",
        "spatie/pdf-to-image": "^3.0",
        "intervention/image": "^3.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}